{%- doc -%}
  Product card in the Golf Asylum style: outlined image, price tab, name.
  Used by the collection, search and "complete the kit" grids.

  @param {product} product - The product to show
  @param {string} [sizes] - Sizes attribute for the image
  @param {string} [sticker] - Text for the round accent sticker, for example "New"
  @param {boolean} [eager] - Load the image eagerly (first row only)

  @example
  {% render 'ga-product-card', product: product, sizes: '(min-width: 750px) 23vw, 46vw' %}
{%- enddoc -%}

{%- liquid
  assign image = product.featured_image
  assign second = product.images[1]
  assign sizes_attr = sizes | default: '(min-width: 990px) 23vw, (min-width: 750px) 31vw, 46vw'
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif

  # Cut-out product shots (PNG) are shown whole; photographs fill the frame.
  assign fit = 'cover'
  if image.src contains '.png'
    assign fit = 'contain'
  endif
-%}

<a class="ga-pcard" href="{{ product.url }}">
  <span class="ga-pcard__frame ga-pcard__frame--{{ fit }}">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 900
        | image_tag: class: 'ga-pcard__img', sizes: sizes_attr, widths: '240, 360, 480, 640, 900', alt: '', loading: loading
      }}
      {%- if second != blank -%}
        {{
          second
          | image_url: width: 900
          | image_tag: class: 'ga-pcard__img ga-pcard__img--hover', sizes: sizes_attr, widths: '240, 360, 480, 640, 900', alt: '', loading: 'lazy'
        }}
      {%- endif -%}
    {%- else -%}
      <span class="ga-pcard__empty" aria-hidden="true">{%- render 'ga-ballhead' -%}</span>
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="ga-label ga-pcard__flag">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif sticker != blank -%}
      <span class="ga-pcard__sticker"><span>{{ sticker | escape }}</span></span>
    {%- endif -%}

    <span class="ga-pcard__price">{{ product.price | money_without_trailing_zeros }}</span>
  </span>

  <span class="ga-pcard__name">{%- render 'ga-title', title: product.title -%}</span>
</a>
