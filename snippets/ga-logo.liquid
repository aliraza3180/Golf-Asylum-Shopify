{%- doc -%}
  Golf Asylum logo lockup: Ballhead mark plus wordmark text.
  Used by the header when no logo image is set in theme settings, and by the footer.

  @param {string} [class] - Extra class names
  @param {boolean} [stacked] - Stack the mark above the wordmark

  @example
  {% render 'ga-logo', class: 'header-logo__ga' %}
{%- enddoc -%}

<span class="ga-logo{% if stacked %} ga-logo--stacked{% endif %}{% if class != blank %} {{ class }}{% endif %}">
  {%- render 'ga-mark', class: 'ga-logo__mark' -%}
  <span class="ga-logo__wordmark">{{ shop.name }}</span>
</span>
