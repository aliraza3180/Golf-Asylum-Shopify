{%- liquid
  assign s = section.settings
  assign country_field_id = 'ga-footer-country-' | append: section.id
-%}

<div class="ga ga--black ga-footer">
  <div class="ga-wrap">
    <div class="ga-footer__top">
      <div class="ga-footer__cols">
        {%- for block in section.blocks -%}
          {%- liquid
            assign bs = block.settings
            assign menu = bs.menu
          -%}
          <nav class="ga-footer__col" aria-label="{{ bs.heading | escape }}" {{ block.shopify_attributes }}>
            {%- if bs.heading != blank -%}
              <h2 class="ga-display ga-footer__heading">{{ bs.heading | escape }}</h2>
            {%- endif -%}
            <ul class="ga-footer__links" role="list">
              {%- if menu.links.size > 0 -%}
                {%- for link in menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..5) -%}
                  {%- liquid
                    assign label_key = 'link_' | append: i | append: '_label'
                    assign url_key = 'link_' | append: i | append: '_url'
                    assign label = bs[label_key]
                    assign url = bs[url_key]
                  -%}
                  {%- if label != blank -%}
                    <li><a href="{{ url | default: routes.root_url }}">{{ label | escape }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </nav>
        {%- endfor -%}
      </div>

      {%- if s.show_logo -%}
        <div class="ga-footer__brand">
          <a class="ga-footer__logo" href="{{ routes.root_url }}">
            {%- render 'ga-mark', class: 'ga-footer__mark' -%}
            {%- render 'ga-wordmark', class: 'ga-footer__wordmark' -%}
          </a>
          {%- if s.tagline != blank -%}
            <p class="ga-hand ga-footer__tagline">{{ s.tagline | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ga-footer__bottom">
      <p class="ga-footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}</span>
        {%- if s.show_policies -%}
          {%- for policy in shop.policies -%}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
      </p>

      <div class="ga-footer__utilities">
        {%- if s.show_country and localization.available_countries.size > 1 -%}
          {%- form 'localization', class: 'ga-footer__country' -%}
            <label class="visually-hidden" for="{{ country_field_id }}">{{ s.country_label | escape }}</label>
            <span class="ga-footer__country-value" aria-hidden="true">
              {{- localization.country.currency.iso_code -}}
              <svg viewBox="0 0 12 8" focusable="false"><path d="M1 1.5l5 5 5-5" /></svg>
            </span>
            <select id="{{ country_field_id }}" name="country_code" data-ga-country-select>
              {%- for country in localization.available_countries -%}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}

        {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          {%- assign wanted_payments = s.payment_types | downcase | remove: ' ' | split: ',' -%}
          <ul class="ga-footer__payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              {%- if wanted_payments.size == 0 or wanted_payments contains type -%}
                <li>{{ type | payment_type_svg_tag: class: 'ga-footer__payment' }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% javascript %}
  document.addEventListener('change', (event) => {
    const select = event.target;
    if (select instanceof HTMLSelectElement && select.matches('[data-ga-country-select]')) {
      select.form?.submit();
    }
  });
{% endjavascript %}

{% stylesheet %}
  .ga-footer {
    padding-block: 48px 28px;
  }

  .ga-footer__top {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .ga-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 20px;
  }

  .ga-footer__heading {
    font-size: 22px;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--ga-bone);
  }

  .ga-footer__links {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .ga-footer__links a {
    color: var(--ga-grey);
    font-size: 17px;
    line-height: 1.2;
    text-decoration: none;
  }

  .ga-footer__links a:hover,
  .ga-footer__legal a:hover {
    color: var(--ga-bone);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ga-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ga-footer__logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--ga-bone);
    text-decoration: none;
  }

  .ga-footer__mark {
    width: 110px;
    --ga-ballhead-stroke: 7;
  }

  .ga-footer__wordmark.ga-wordmark-image {
    height: 58px;
  }

  .ga-footer__wordmark {
    font-family: var(--font-body--family);
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ga-footer__tagline {
    margin-block-start: 10px;
    color: var(--ga-bone);
    font-size: 28px;
    line-height: 1.02;
    text-align: center;
    transform-origin: center;
    --ga-hand-tilt: -5deg;
  }

  .ga-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-block-start: 40px;
    padding-block-start: 24px;
    border-top: 1px solid var(--ga-graphite);
  }

  .ga-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0;
    color: var(--ga-grey);
    font-size: 13px;
    line-height: 1.3;
  }

  .ga-footer__legal a {
    color: inherit;
    text-decoration: none;
  }

  .ga-footer__utilities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .ga-footer__country {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .ga-footer__country-value {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ga-bone);
    font-size: 15px;
    line-height: 1;
  }

  .ga-footer__country-value svg {
    width: 12px;
    height: 8px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .ga-footer__country select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    font-size: 16px;
  }

  .ga-footer__country:focus-within .ga-footer__country-value {
    outline: 2px solid var(--ga-bone);
    outline-offset: 6px;
  }

  .ga-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ga-footer__payments li {
    display: flex;
  }

  .ga-footer__payment {
    width: 44px;
    height: auto;
    filter: grayscale(1);
  }

  @media screen and (min-width: 750px) {
    .ga-footer {
      padding-block: calc(var(--ga-u) * 62) calc(var(--ga-u) * 34);
    }

    .ga-footer__top {
      flex-direction: row;
      justify-content: space-between;
      gap: calc(var(--ga-u) * 40);
      min-height: calc(var(--ga-u) * 298);
      padding-inline: calc(var(--ga-u) * 61) calc(var(--ga-u) * 22);
    }

    .ga-footer__cols {
      display: flex;
      gap: 0;
      padding-block-start: calc(var(--ga-u) * 16);
    }

    .ga-footer__col {
      width: calc(var(--ga-u) * 320);
    }

    .ga-footer__heading {
      font-size: calc(var(--ga-u) * 25);
    }

    .ga-footer__links {
      gap: calc(var(--ga-u) * 15);
      margin-block-start: calc(var(--ga-u) * 26);
    }

    .ga-footer__links a {
      font-size: max(14px, calc(var(--ga-u) * 20.5));
    }

    .ga-footer__logo {
      gap: calc(var(--ga-u) * 14);
    }

    .ga-footer__mark {
      width: calc(var(--ga-u) * 140);
    }

    .ga-footer__wordmark {
      font-size: calc(var(--ga-u) * 34);
    }

    .ga-footer__tagline {
      margin-block-start: calc(var(--ga-u) * 14);
      font-size: max(24px, calc(var(--ga-u) * 36));
    }

    .ga-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      margin-block-start: calc(var(--ga-u) * 8);
      padding-block-start: calc(var(--ga-u) * 22);
      padding-inline: calc(var(--ga-u) * 10) 0;
    }

    .ga-footer__legal {
      font-size: max(12px, calc(var(--ga-u) * 14));
    }

    .ga-footer__utilities {
      flex-wrap: nowrap;
      gap: calc(var(--ga-u) * 40);
    }

    .ga-footer__country-value {
      font-size: max(13px, calc(var(--ga-u) * 15));
    }

    .ga-footer__payment {
      width: calc(var(--ga-u) * 46);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GA Footer",
  "tag": "footer",
  "class": "ga-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show the logo",
      "default": true
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Handwritten line under the logo",
      "default": "the only way to play\nis out of your mind",
      "info": "A line break starts a new line."
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Show the country and currency selector",
      "default": true
    },
    {
      "type": "text",
      "id": "country_label",
      "label": "Country selector description",
      "info": "Read out by screen readers.",
      "default": "Country and currency"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_types",
      "label": "Payment icons to show",
      "info": "Comma-separated. Only methods the store accepts are shown. Leave empty to show them all.",
      "default": "visa, master, american_express, discover, apple_pay, paypal"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "When a menu is picked, the links below are ignored."
        },
        {
          "type": "header",
          "content": "Links without a menu"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Link 1 label"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Link 1"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Link 2 label"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Link 2"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "Link 3 label"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "Link 3"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "Link 4 label"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Link 4"
        },
        {
          "type": "text",
          "id": "link_5_label",
          "label": "Link 5 label"
        },
        {
          "type": "url",
          "id": "link_5_url",
          "label": "Link 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GA Footer",
      "blocks": [
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
