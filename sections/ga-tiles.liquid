{%- liquid
  assign s = section.settings
-%}

<div class="ga ga--black ga-tiles">
  <div class="ga-wrap">
    <div class="ga-head ga-tiles__head">
      {%- if s.heading != blank -%}
        <h2 class="ga-display ga-tiles__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.link_label != blank -%}
        <a class="ga-link" href="{{ s.link | default: routes.collections_url }}">{{ s.link_label | escape }}</a>
      {%- endif -%}
    </div>

    <ul class="ga-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bs = block.settings
          assign variant = forloop.index0 | modulo: 3 | plus: 1
          assign fallback = blank
          if bs.bundled_image != 'none'
            assign fallback = bs.bundled_image
          endif
          assign url = bs.link | default: bs.collection.url | default: routes.collections_url
          assign label = bs.label | default: bs.collection.title
        -%}
        <li
          class="ga-tile ga-tile--{{ variant }}"
          style="--ga-zoom: {{ bs.zoom | divided_by: 100.0 }}; --ga-focus-x: {{ bs.focus_x }}%; --ga-focus-y: {{ bs.focus_y }}%;"
          {{ block.shopify_attributes }}
        >
          <a class="ga-tile__link" href="{{ url }}">
            <span class="ga-torn ga-torn--{{ variant | plus: 1 }} ga-tile__paper">
              <span class="ga-torn__media">
                {%- if bs.image != blank or fallback != blank -%}
                  {%- render 'ga-image', image: bs.image, fallback: fallback, alt: '', sizes: '(min-width: 750px) 48vw, 140vw', width: 1800 -%}
                {%- elsif bs.collection.featured_image != blank -%}
                  {%- render 'ga-image',
                    image: bs.collection.featured_image,
                    fallback: fallback,
                    alt: '',
                    sizes: '(min-width: 750px) 31vw, 92vw',
                    width: 1200
                  -%}
                {%- endif -%}
              </span>
            </span>
            {%- if label != blank -%}
              <span class="ga-label ga-tile__label">{{ label | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .ga-tiles {
    padding-block: 48px 64px;
  }

  .ga-tiles__head {
    margin-block-end: 24px;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .ga-tiles__title {
    font-size: 17vw;
  }

  .ga-tiles__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 44px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ga-tile__link {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ga-tile__paper {
    aspect-ratio: 436 / 610;
    transition: transform 0.25s ease-out;
  }

  .ga-tile--1 .ga-tile__paper {
    --ga-tilt: -1deg;
  }

  .ga-tile--3 .ga-tile__paper {
    --ga-tilt: 1deg;
  }

  .ga-tile__paper img {
    object-position: var(--ga-focus-x, 50%) var(--ga-focus-y, 50%);
    transform: scale(var(--ga-zoom, 1));
    transform-origin: var(--ga-focus-x, 50%) var(--ga-focus-y, 50%);
  }

  .ga-tile__label {
    position: absolute;
    left: 4%;
    bottom: -18px;
    font-size: 30px;
  }

  .ga-tile--2 .ga-tile__label {
    --ga-label-tilt: -2deg;
  }

  .ga-tile__link:hover .ga-tile__paper {
    transform: rotate(var(--ga-tilt, 0deg)) scale(1.015);
  }

  @media screen and (min-width: 750px) {
    .ga-tiles {
      padding-block: calc(var(--ga-u) * 82) calc(var(--ga-u) * 140);
    }

    .ga-tiles__head {
      flex-wrap: nowrap;
      align-items: center;
      margin-block-end: calc(var(--ga-u) * 24);
      padding-inline: calc(var(--ga-u) * 24) calc(var(--ga-u) * 22);
    }

    .ga-tiles__title {
      font-size: calc(var(--ga-u) * 112);
    }

    .ga-tiles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: calc(var(--ga-u) * 26);
    }

    .ga-tile__label {
      left: calc(var(--ga-u) * 22);
      bottom: calc(var(--ga-u) * -34);
      font-size: calc(var(--ga-u) * 42);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ga-tile__paper {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GA Category tiles",
  "tag": "section",
  "class": "ga-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop youth"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all youth"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Say who it is for as well as what it is, for example: Youth polos."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Overrides the collection link."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Portrait works best."
        },
        {
          "type": "select",
          "id": "bundled_image",
          "label": "Bundled photo",
          "info": "Shown until you pick a photo.",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "ga-youth-polos.jpg",
              "label": "Juniors in polos"
            },
            {
              "value": "ga-youth-hoodies.jpg",
              "label": "Junior in a hoodie"
            },
            {
              "value": "ga-youth-shorts.jpg",
              "label": "Junior in shorts"
            }
          ],
          "default": "none"
        },
        {
          "type": "header",
          "content": "Photo framing"
        },
        {
          "type": "range",
          "id": "zoom",
          "label": "Zoom",
          "min": 100,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "range",
          "id": "focus_x",
          "label": "Focus, left to right",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focus_y",
          "label": "Focus, top to bottom",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GA Category tiles",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
