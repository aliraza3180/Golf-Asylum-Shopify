{%- liquid
  assign s = section.settings
-%}

<div class="ga ga--bone ga-steps">
  <div class="ga-wrap">
    <div class="ga-steps__head">
      {%- if s.note != blank -%}
        <p class="ga-hand ga-hand--underline ga-steps__note">{{ s.note | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="ga-display ga-steps__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ol class="ga-steps__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        <li class="ga-step" {{ block.shopify_attributes }}>
          <span class="ga-step__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          {%- if bs.title != blank -%}
            <h3 class="ga-display ga-step__title">{{ bs.title | escape }}</h3>
          {%- endif -%}
          {%- if bs.text != blank -%}
            <div class="ga-step__text">{{ bs.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if s.button_label != blank and s.button_link != blank -%}
      <div class="ga-steps__foot">
        <a class="ga-btn ga-btn--dark" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>
        {%- if s.foot_note != blank -%}
          <p class="ga-steps__foot-note">{{ s.foot_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ga-steps {
    padding-block: 52px 60px;
  }

  .ga-steps__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-block-end: 36px;
  }

  .ga-steps__note {
    font-size: 32px;
    margin-block-end: 0.5em;
    --ga-hand-tilt: -4deg;
  }

  .ga-steps__title {
    font-size: 15vw;
  }

  .ga-steps__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ga-step {
    position: relative;
    padding: 44px 20px 24px;
    border: 2px solid var(--ga-black);
    background: var(--ga-white);
  }

  .ga-step__number {
    position: absolute;
    top: -20px;
    left: -2px;
    display: grid;
    place-items: center;
    min-width: 58px;
    height: 44px;
    padding: 0 12px;
    background: var(--ga-black);
    color: var(--ga-bone);
    font-family: var(--ga-font-display);
    font-size: 26px;
    line-height: 1;
  }

  .ga-step__title {
    font-size: 34px;
  }

  .ga-step__text {
    margin-block-start: 12px;
    font-size: 16px;
    line-height: 1.55;
  }

  .ga-step__text p {
    margin: 0 0 0.6em;
  }

  .ga-step__text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .ga-steps__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-block-start: 36px;
  }

  .ga-steps__foot-note {
    margin: 0;
    color: #55555a;
    font-size: 15px;
  }

  @media screen and (min-width: 750px) {
    .ga-steps {
      padding-block: calc(var(--ga-u) * 104) calc(var(--ga-u) * 112);
    }

    .ga-steps__head {
      margin-block-end: calc(var(--ga-u) * 64);
      padding-inline-start: calc(var(--ga-u) * 16);
    }

    .ga-steps__note {
      font-size: calc(var(--ga-u) * 44);
    }

    .ga-steps__title {
      font-size: calc(var(--ga-u) * 104);
    }

    .ga-steps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: calc(var(--ga-u) * 24);
    }

    .ga-step {
      padding: calc(var(--ga-u) * 60) calc(var(--ga-u) * 34) calc(var(--ga-u) * 40);
    }

    .ga-step__number {
      top: calc(var(--ga-u) * -26);
      min-width: calc(var(--ga-u) * 78);
      height: calc(var(--ga-u) * 56);
      font-size: calc(var(--ga-u) * 34);
    }

    .ga-step__title {
      font-size: max(28px, calc(var(--ga-u) * 46));
    }

    .ga-step__text {
      margin-block-start: calc(var(--ga-u) * 16);
      font-size: max(15px, calc(var(--ga-u) * 18));
    }

    .ga-steps__foot {
      flex-direction: row;
      align-items: center;
      gap: calc(var(--ga-u) * 28);
      margin-block-start: calc(var(--ga-u) * 56);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GA Steps",
  "tag": "section",
  "class": "ga-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "note",
      "label": "Handwritten note"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "foot_note",
      "label": "Text beside the button"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "What you get"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this step.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GA Steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
