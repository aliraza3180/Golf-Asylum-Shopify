{%- liquid
  assign s = section.settings
  assign content = s.content | default: page.content
-%}

{%- if content != blank -%}
  <div class="ga ga--white ga-pagebody">
    <div class="ga-wrap">
      <div class="ga-prose ga-pagebody__text">{{ content }}</div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ga-pagebody {
    padding-block: 40px 72px;
  }

  @media screen and (min-width: 750px) {
    .ga-pagebody {
      padding-block: calc(var(--ga-u) * 72) calc(var(--ga-u) * 130);
    }

    .ga-pagebody__text {
      margin-inline-start: calc(var(--ga-u) * 16);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GA Page text",
  "tag": "section",
  "class": "ga-section",
  "settings": [
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "info": "Leave empty to show the text written on the page itself."
    }
  ],
  "presets": [
    {
      "name": "GA Page text"
    }
  ]
}
{% endschema %}
