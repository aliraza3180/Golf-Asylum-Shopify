<div class="ga ga--white ga-duo">
  <div class="ga-wrap">
    <ul class="ga-duo__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bs = block.settings
          assign fallback = blank
          if bs.bundled_image != 'none'
            assign fallback = bs.bundled_image
          endif
          assign url = bs.button_link | default: routes.all_products_collection_url
        -%}
        <li class="ga-duo__tile ga-duo__tile--{{ bs.style }}" {{ block.shopify_attributes }}>
          {%- if bs.image != blank or fallback != blank -%}
            <div class="ga-duo__media{% if bs.style == 'photo' and bs.black_and_white %} ga-duo__media--bw{% endif %}">
              {%- render 'ga-image', image: bs.image, fallback: fallback, alt: bs.image_alt, sizes: '(min-width: 750px) 47vw, 92vw', width: 1400 -%}
            </div>
          {%- endif -%}

          <div class="ga-duo__copy">
            {%- if bs.heading != blank -%}
              <h2 class="ga-display ga-duo__title">{{ bs.heading | escape }}</h2>
            {%- endif -%}
            {%- if bs.text != blank -%}
              <p class="ga-text ga-duo__text">{{ bs.text | escape }}</p>
            {%- endif -%}
            {%- if bs.button_label != blank -%}
              <a class="ga-btn {% if bs.style == 'photo' %}ga-btn--outline-light{% else %}ga-btn--dark{% endif %} ga-duo__btn" href="{{ url }}">
                {{- bs.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .ga-duo {
    padding-block: 40px 48px;
  }

  .ga-duo__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ga-duo__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 5;
    border: 2px solid var(--ga-black);
    overflow: hidden;
  }

  .ga-duo__tile--photo {
    background: var(--ga-black);
    color: var(--ga-bone);
  }

  .ga-duo__tile--product {
    background: var(--ga-white);
    color: var(--ga-black);
  }

  .ga-duo__media {
    position: absolute;
  }

  .ga-duo__media img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ga-duo__tile--photo .ga-duo__media {
    inset: 0 0 26% 0;
  }

  .ga-duo__tile--photo .ga-duo__media img {
    object-fit: cover;
    object-position: center top;
  }

  .ga-duo__tile--photo .ga-duo__media--bw img {
    filter: grayscale(1) contrast(1.08);
  }

  .ga-duo__tile--photo .ga-duo__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(10 10 10 / 0) 42%, rgb(10 10 10 / 0.7) 72%, var(--ga-black) 100%);
  }

  .ga-duo__tile--product .ga-duo__media {
    top: 8%;
    left: 3%;
    width: 94%;
    aspect-ratio: 3 / 2;
  }

  .ga-duo__tile--product .ga-duo__media img {
    object-fit: contain;
  }

  .ga-duo__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px;
  }

  .ga-duo__title {
    font-size: 11.5vw;
    white-space: nowrap;
  }

  .ga-duo__text {
    margin-block-start: 10px;
  }

  .ga-duo__btn {
    margin-block-start: 18px;
  }

  @media screen and (min-width: 750px) {
    .ga-duo {
      padding-block: calc(var(--ga-u) * 86) calc(var(--ga-u) * 87);
    }

    .ga-duo__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: calc(var(--ga-u) * 12);
    }

    .ga-duo__tile {
      aspect-ratio: 708 / 827;
    }

    .ga-duo__tile--product .ga-duo__media {
      top: 13%;
    }

    .ga-duo__copy {
      padding: calc(var(--ga-u) * 38) calc(var(--ga-u) * 36);
    }

    .ga-duo__title {
      font-size: calc(var(--ga-u) * 90);
      white-space: nowrap;
    }

    .ga-duo__text {
      margin-block-start: calc(var(--ga-u) * 16);
    }

    .ga-duo__btn {
      min-width: calc(var(--ga-u) * 269);
      min-height: calc(var(--ga-u) * 60);
      margin-block-start: calc(var(--ga-u) * 24);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GA Two tiles",
  "tag": "section",
  "class": "ga-section",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "photo",
              "label": "Photo, dark"
            },
            {
              "value": "product",
              "label": "Product, light"
            }
          ],
          "default": "photo"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "For the caddy."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Adult polos now. Hoodies coming soon."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop adult"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Photo style: a person on a course. Product style: products alone on white."
        },
        {
          "type": "select",
          "id": "bundled_image",
          "label": "Bundled image",
          "info": "Shown until you pick an image. The adult golfer is a placeholder and must be replaced with a real photo before launch.",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "ga-placeholder-adult-golfer.jpg",
              "label": "Placeholder: adult golfer"
            },
            {
              "value": "ga-caps.jpg",
              "label": "Three caps"
            }
          ],
          "default": "none"
        },
        {
          "type": "checkbox",
          "id": "black_and_white",
          "label": "Photo style: show in black and white",
          "default": false
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GA Two tiles",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "style": "photo"
          }
        },
        {
          "type": "tile",
          "settings": {
            "style": "product",
            "heading": "Caps & beanies.",
            "text": "Finish the fit.",
            "button_label": "Shop caps & beanies"
          }
        }
      ]
    }
  ]
}
{% endschema %}
